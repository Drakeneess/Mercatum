{
  "name": "@mercatum/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js",
    "test": "pnpm build && node --test dist/domain/*.test.js",
    "smoke:v1": "node dist/smoke-v1.js",
    "smoke:v2": "node dist/smoke-v2.js"
  },
  "dependencies": {
    "@mercatum/shared": "workspace:*",
    "colyseus": "^0.18.10",
    "dotenv": "^17.2.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "@colyseus/sdk": "^0.18.9",
    "@types/pg": "^8.15.5"
  }
}
